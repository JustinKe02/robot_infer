+@dataclass
+class RTCTrainingConfig:
+    """Configuration for clean-prefix, postfix-only RTC training.
+
+    ``max_delay`` is expressed in action steps.  A delay of zero keeps the full
+    action chunk trainable, while larger delays commit a clean prefix and mask
+    it out of the flow-matching loss.
+    """
+
+    enabled: bool = False
+    max_delay: int = 10
+    min_postfix_steps: int = 1
+    observed_delay_histogram: tuple[float, ...] = ()
+    observed_histogram_weight: float = 0.9
+
+    def __post_init__(self) -> None:
+        if self.max_delay < 0:
+            raise ValueError(f"max_delay must be non-negative, got {self.max_delay}")
+        if self.min_postfix_steps <= 0:
+            raise ValueError(f"min_postfix_steps must be positive, got {self.min_postfix_steps}")
+        if not 0.0 <= self.observed_histogram_weight <= 1.0:
+            raise ValueError(
+                "observed_histogram_weight must be between 0 and 1, "
+                f"got {self.observed_histogram_weight}"
+            )
+        if self.observed_delay_histogram:
+            if len(self.observed_delay_histogram) != self.max_delay + 1:
+                raise ValueError(
+                    "observed_delay_histogram must have max_delay + 1 entries, "
+                    f"got {len(self.observed_delay_histogram)} for max_delay={self.max_delay}"
+                )
+            if any(
+                not math.isfinite(weight) or weight < 0 for weight in self.observed_delay_histogram
+            ):
+                raise ValueError("observed_delay_histogram must contain finite non-negative values")
+            if sum(self.observed_delay_histogram) <= 0:
+                raise ValueError("observed_delay_histogram must contain a positive value")
+
+
