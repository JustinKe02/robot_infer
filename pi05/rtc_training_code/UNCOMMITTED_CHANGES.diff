+def sample_rtc_training_delay(
+    batch_size: int,
+    horizon: int,
+    config: RTCTrainingConfig,
+    device: torch.device,
+) -> Tensor:
+    """Sample one committed-prefix length per batch item."""
+    max_delay = min(config.max_delay, horizon - config.min_postfix_steps)
+    if max_delay < 0:
+        raise ValueError(
+            f"min_postfix_steps ({config.min_postfix_steps}) exceeds action horizon ({horizon})"
+        )
+
+    if not config.observed_delay_histogram:
+        return torch.randint(0, max_delay + 1, (batch_size,), dtype=torch.long, device=device)
+
+    observed_weights = torch.as_tensor(
+        config.observed_delay_histogram[: max_delay + 1], dtype=torch.float32, device=device
+    )
+    uniform_weights = torch.full_like(observed_weights, 1.0 / observed_weights.numel())
+    if observed_weights.sum() > 0:
+        observed_weights = observed_weights / observed_weights.sum()
+    else:
+        observed_weights = uniform_weights
+    weights = (
+        config.observed_histogram_weight * observed_weights
+        + (1.0 - config.observed_histogram_weight) * uniform_weights
+    )
+    return torch.multinomial(weights.expand(batch_size, -1), num_samples=1).squeeze(1)
+
+
+def build_rtc_training_inputs(
+    actions: Tensor,
+    noise: Tensor,
+    global_flow_time: Tensor,
+    delay: Tensor,
+) -> tuple[Tensor, Tensor, Tensor]:
+    """Build clean-prefix flow inputs and their local time/mask conditions."""
+    if actions.shape != noise.shape or actions.ndim != 3:
+        raise ValueError(
+            f"actions and noise must have the same [B,H,D] shape, got {actions.shape} and {noise.shape}"
+        )
+    batch_size, horizon = actions.shape[:2]
+    if global_flow_time.shape != (batch_size,):
+        raise ValueError(
+            f"global_flow_time must have shape ({batch_size},), got {global_flow_time.shape}"
+        )
+    if delay.shape != (batch_size,):
+        raise ValueError(f"delay must have shape ({batch_size},), got {delay.shape}")
+    if torch.any(delay < 0) or torch.any(delay >= horizon):
+        raise ValueError(f"delay must be in [0, {horizon - 1}]")
+
+    step_index = torch.arange(horizon, device=actions.device)
+    prefix_mask = step_index[None, :] < delay[:, None]
+    global_token_time = global_flow_time[:, None].expand(batch_size, horizon)
+    token_flow_time = torch.where(prefix_mask, torch.zeros_like(global_token_time), global_token_time)
+    x_t = token_flow_time[:, :, None] * noise + (1.0 - token_flow_time[:, :, None]) * actions
+    return x_t, token_flow_time, prefix_mask
+
+
+def rtc_masked_loss(
+    losses: Tensor,
+    postfix_mask: Tensor,
+) -> tuple[Tensor, Tensor]:
+    """Return an equal-weight mean and per-sample postfix loss."""
+    if losses.ndim != 3:
+        raise ValueError(f"losses must have shape [B,H,D], got {losses.shape}")
+    if postfix_mask.shape != losses.shape[:2]:
+        raise ValueError(
+            f"postfix_mask must have shape {losses.shape[:2]}, got {postfix_mask.shape}"
+        )
+    mask = postfix_mask[:, :, None].to(dtype=losses.dtype)
+    valid_per_sample = mask.sum(dim=(1, 2)) * losses.shape[-1]
+    if torch.any(valid_per_sample == 0):
+        raise ValueError("Every RTC training sample must retain at least one postfix action step")
+    per_sample_loss = (losses * mask).sum(dim=(1, 2)) / valid_per_sample
+    return per_sample_loss.mean(), per_sample_loss
+
+
+def prepare_rtc_action_prefix(
+    action_prefix: Tensor,
+    prefix_length: int | None,
+    reference: Tensor,
+) -> tuple[Tensor, Tensor]:
+    """Validate and pad an inference-time clean action prefix."""
+    if reference.ndim != 3:
+        raise ValueError(f"reference must have shape [B,H,D], got {reference.shape}")
+    batch_size, horizon, action_dim = reference.shape
+    if action_prefix.ndim == 2:
+        if batch_size != 1:
+            raise ValueError("A [P,D] action_prefix is only valid for batch size 1")
+        action_prefix = action_prefix.unsqueeze(0)
+    if action_prefix.ndim != 3 or action_prefix.shape[0] != batch_size:
+        raise ValueError(
+            f"action_prefix must have shape [B,P,D] for B={batch_size}, got {action_prefix.shape}"
+        )
+    available_prefix = action_prefix.shape[1]
+    if prefix_length is None:
+        prefix_length = available_prefix
+    if not 0 <= prefix_length <= min(available_prefix, horizon):
+        raise ValueError(
+            f"prefix_length must be in [0, {min(available_prefix, horizon)}], got {prefix_length}"
+        )
+    if action_prefix.shape[-1] > action_dim:
+        raise ValueError(
+            f"action_prefix dimension {action_prefix.shape[-1]} exceeds model dimension {action_dim}"
+        )
+
+    prefix_values = torch.zeros_like(reference)
+    prefix_values[:, :prefix_length, : action_prefix.shape[-1]] = action_prefix[
+        :, :prefix_length
+    ].to(device=reference.device, dtype=reference.dtype)
+    prefix_mask = torch.arange(horizon, device=reference.device)[None, :] < prefix_length
+    prefix_mask = prefix_mask.expand(batch_size, horizon)
+    return prefix_values, prefix_mask
+
